{
  "name": "week-18",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "cd packages/db && npx prisma generate",
    "start-user-app": "cd ./apps/user-app && npm run start",
    "start-merchant-app": "cd ./apps/merchant-app && npm run start",
    "start-webhook": "cd ./apps/bank_webhook_handler && npm run start"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.8"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
